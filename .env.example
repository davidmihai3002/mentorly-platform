# Copiază fișierul în .env.local și completează valorile. .env.local nu se commit-uie.
# Tot ce începe cu VITE_ ajunge în bundle-ul public: nu pune secrete aici.

# URL-ul API-ului (repo-ul mentorly-api), fără slash la final
VITE_API_URL=http://localhost:3000

# "true" = folosește mock-urile MSW în locul API-ului real (SCRUM-283)
VITE_USE_MOCKS=true
